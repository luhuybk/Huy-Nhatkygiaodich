# Chép file này thành .env.deploy (đã nằm trong .gitignore, không lên GitHub) rồi điền.
# Lấy thông tin ở hPanel Hostinger → Websites → Files → FTP Accounts.
FTP_HOST=ftp.tenmien-cua-ban.com
FTP_USER=u123456789
FTP_PASSWORD=
# Thư mục chứa trang tính từ thư mục gốc của tài khoản FTP (thường là public_html).
FTP_DIR=public_html
# true = FTPS (mã hoá). Kết nối không được thì thử false.
FTP_SECURE=true
# Không bắt buộc: địa chỉ trang để script tải thử sau khi upload.
SITE_URL=https://tenmien-cua-ban.com
